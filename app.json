{
  "expo": {
    "name": "Memento",
    "slug": "memento",
    "version": "1.0.0",
    "scheme": "memento",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FDFAF7"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.memento.app",
      "associatedDomains": [
        "applinks:app.memento.ai",
        "applinks:app.memento.ai"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.memento.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDFAF7"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.memento.ai",
              "pathPrefix": "/accept-invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Memento to access your camera to capture photos and videos for your memories."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Memento to access your photos to attach them to your memories.",
          "cameraPermission": "Allow Memento to use your camera to capture memories."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Memento to access your microphone for voice recordings."
        }
      ],
      "expo-web-browser",
      "expo-audio",
      "@react-native-community/datetimepicker",
      [
        "@sentry/react-native/expo",
        {
          "organization": "memento",
          "project": "memento-mobile"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "07e90f37-08ee-4364-ac02-1e54b08844e7"
      }
    }
  }
}
