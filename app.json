{
  "expo": {
    "name": "Memento",
    "slug": "memento",
    "version": "1.0.0",
    "scheme": "memento",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mementoai.app",
      "associatedDomains": [
        "applinks:app.memento.ai"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.mementoai.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#fefbf8"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.memento.ai",
              "pathPrefix": "/accept-invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "SEND",
          "data": [
            { "mimeType": "image/*" },
            { "mimeType": "video/*" },
            { "mimeType": "audio/*" },
            { "mimeType": "application/pdf" },
            { "mimeType": "text/plain" }
          ],
          "category": ["DEFAULT"]
        },
        {
          "action": "SEND_MULTIPLE",
          "data": [
            { "mimeType": "image/*" },
            { "mimeType": "video/*" }
          ],
          "category": ["DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Memento to access your camera to capture photos and videos for your memories."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Memento to access your photos to attach them to your memories.",
          "cameraPermission": "Allow Memento to use your camera to capture memories.",
          "microphonePermission": "Allow Memento to record audio for videos and voice memos."
        }
      ],
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Memento to access your microphone for voice recordings."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@sentry/react-native/expo",
        {
          "organization": "memento",
          "project": "memento-mobile"
        }
      ],
      "@sentry/react-native",
      "expo-asset",
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Memento to use the microphone for voice input.",
          "speechRecognitionPermission": "Allow Memento to use speech recognition."
        }
      ],
      "expo-dev-client",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#fefbf8"
        }
      ],
      "expo-status-bar",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 0,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 0,
            "NSExtensionActivationSupportsImageWithMaxCount": 10,
            "NSExtensionActivationSupportsMovieWithMaxCount": 5,
            "NSExtensionActivationSupportsFileWithMaxCount": 5
          },
          "androidIntentFilters": [
            "image/*",
            "video/*",
            "audio/*",
            "application/pdf",
            "text/plain"
          ]
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Memento to save media to your photo library.",
          "savePhotosPermission": "Allow Memento to save photos and videos to your library.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "07e90f37-08ee-4364-ac02-1e54b08844e7"
      }
    }
  }
}
