{
  "expo": {
    "name": "Memento",
    "slug": "memento",
    "version": "1.0.0",
    "scheme": "memento",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "io.mymemento.app",
      "appleTeamId": "LKYKU36B7W",
      "associatedDomains": [
        "applinks:app.mymemento.io",
        "webcredentials:app.mymemento.io",
        "webcredentials:dev.mymemento.io"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSSpeechRecognitionUsageDescription": "Memento turns what you say into text for your stories and chats.",
        "NSMicrophoneUsageDescription": "Memento uses the microphone for voice calls with your AI companion and for recording stories.",
        "NSFaceIDUsageDescription": "Memento uses Face ID to unlock your private vault and sign you in."
      }
    },
    "android": {
      "package": "io.mymemento.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#FF5E00"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "app.mymemento.io",
              "pathPrefix": "/accept-invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "SEND",
          "data": [
            {
              "mimeType": "image/*"
            },
            {
              "mimeType": "video/*"
            },
            {
              "mimeType": "audio/*"
            },
            {
              "mimeType": "application/pdf"
            },
            {
              "mimeType": "text/plain"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        },
        {
          "action": "SEND_MULTIPLE",
          "data": [
            {
              "mimeType": "image/*"
            },
            {
              "mimeType": "video/*"
            }
          ],
          "category": [
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/with-ios-script-paths",
      "./plugins/with-extension-react-native-path",
      "./plugins/with-storekit-config",
      "./plugins/with-audio-api-ffmpeg-disabled",
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Memento uses Face ID to unlock your private vault and sign you in."
        }
      ],
      "expo-font",
      "expo-apple-authentication",
      "expo-sharing",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.246773083886-nkljj6mafpodch7a8mv1g5khn91sv8a4"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Memento to access your camera to capture photos and videos for your memories.",
          "microphonePermission": "Memento uses the microphone for voice calls with your AI companion and for recording stories."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Memento to access your photos to attach them to your memories.",
          "cameraPermission": "Allow Memento to use your camera to capture memories.",
          "microphonePermission": "Memento uses the microphone for voice calls with your AI companion and for recording stories."
        }
      ],
      "expo-web-browser",
      [
        "expo-audio",
        {
          "microphonePermission": "Memento uses the microphone for voice calls with your AI companion and for recording stories.",
          "enableBackgroundRecording": true
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@sentry/react-native/expo",
        {
          "organization": "memento",
          "project": "memento-mobile"
        }
      ],
      "@sentry/react-native",
      "expo-asset",
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Memento uses the microphone for voice calls with your AI companion and for recording stories.",
          "speechRecognitionPermission": "Memento turns what you say into text for your stories and chats."
        }
      ],
      "expo-dev-client",
      [
        "react-native-audio-api",
        {
          "iosMicrophonePermission": "Memento uses the microphone for voice calls with your AI companion and for recording stories.",
          "iosBackgroundMode": true,
          "androidPermissions": [
            "android.permission.RECORD_AUDIO",
            "android.permission.MODIFY_AUDIO_SETTINGS",
            "android.permission.FOREGROUND_SERVICE",
            "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
            "android.permission.FOREGROUND_SERVICE_MICROPHONE",
            "android.permission.POST_NOTIFICATIONS"
          ],
          "androidForegroundService": true,
          "androidFSTypes": [
            "mediaPlayback",
            "microphone"
          ]
        }
      ],
      "expo-image",
      "./plugins/with-blank-splash-logo",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF"
        }
      ],
      "expo-status-bar",
      "expo-iap",
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsWebURLWithMaxCount": 0,
            "NSExtensionActivationSupportsWebPageWithMaxCount": 0,
            "NSExtensionActivationSupportsImageWithMaxCount": 10,
            "NSExtensionActivationSupportsMovieWithMaxCount": 5,
            "NSExtensionActivationSupportsFileWithMaxCount": 5
          },
          "androidIntentFilters": [
            "image/*",
            "video/*",
            "audio/*",
            "application/pdf",
            "text/plain"
          ]
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Memento to save media to your photo library.",
          "savePhotosPermission": "Allow Memento to save photos and videos to your library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "07e90f37-08ee-4364-ac02-1e54b08844e7"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/07e90f37-08ee-4364-ac02-1e54b08844e7"
    }
  }
}
