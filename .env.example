EXPO_PUBLIC_API_BASE_URL=https://dev.mymemento.io/api
# Production builds should use:
# EXPO_PUBLIC_API_BASE_URL=https://app.mymemento.io/api
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.2

# Voice calls
# Keep the mic open while Memento speaks on the loudspeaker. On iOS this only
# takes effect when voice processing below is also on.
EXPO_PUBLIC_VOICE_FULL_DUPLEX=false
# Apple's voice-processing unit (echo cancellation). TestFlight builds turn it
# on; production leaves it off until speaker echo at full volume is solved
# (see src/features/chat/voice-audio-policy.ts).
EXPO_PUBLIC_VOICE_IOS_VOICE_PROCESSING=false
